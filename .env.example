# ─────────────────────────────────────────────────────────────
# Quest Horror Clinic — переменные окружения
# Скопируйте этот файл в `.env.local` и заполните значения.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта (используется в SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Пароль для входа в /admin.
# ВАЖНО: в продакшене переменная обязательна — без неё (и без
# ADMIN_SESSION_SECRET) панель администратора полностью отключена.
ADMIN_PASSWORD=change-me-please

# Секрет для подписи cookie админ-сессии (случайная строка 32+ символа)
ADMIN_SESSION_SECRET=change-me-too-long-random-string

# Служебный доступ для автотестов (сброс лимитов частоты).
# В продакшене НЕ задавать.
# ALLOW_TEST_ENDPOINTS=1

# Уведомления о новых бронях (необязательно — если не заполнено,
# заявка просто сохраняется в базе, а менеджер видит её в /admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
