# ─────────────────────────────────────────────────────────────────────────────
# Quest Horror Clinic — переменные окружения
#
# Скопируйте файл в `.env.local` для разработки.
# В продакшене задайте эти же переменные в панели хостинга (Vercel → Settings →
# Environment Variables). Файл `.env.local` в репозиторий не попадает.
#
# Правило: секреты живут только здесь. В коде нет ни одного пароля по умолчанию —
# без переменных соответствующая функция просто отключается, а не работает
# «на дефолтном пароле».
# ─────────────────────────────────────────────────────────────────────────────

# ── Обязательно в продакшене ────────────────────────────────────────────────

# Публичный адрес сайта. Используется в canonical, sitemap, Open Graph,
# в ссылке «поделиться» и в письме-подтверждении.
NEXT_PUBLIC_SITE_URL=https://example.kz

# Пароль администратора для /admin.
# Без ADMIN_PASSWORD и ADMIN_SESSION_SECRET панель полностью отключена.
ADMIN_PASSWORD=change-me-please

# Секрет для подписи cookie админ-сессии. Случайная строка 32+ символа.
# Пример генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too-long-random-string

# ── Планировщик напоминаний ─────────────────────────────────────────────────

# Секрет для вызова /api/cron/reminders.
# Без него эндпоинт закрыт для внешних вызовов: иначе любой мог бы запустить
# рассылку напоминаний. Задайте и повесьте вызов каждые 15–30 минут:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://example.kz/api/cron/reminders
CRON_SECRET=

# ── Хранилище ───────────────────────────────────────────────────────────────

# По умолчанию брони лежат в файле .data/bookings.json — этого достаточно
# для одного сервера и для демонстрации владельцу.
#
# Для продакшена задайте DATABASE_URL и установите драйвер:  npm i pg
# Затем примените схему:                                    npm run migrate
# DATABASE_URL=postgres://user:password@host:5432/quest
#
# Драйвер подключается динамически: без DATABASE_URL пакет pg не нужен.

# ── Уведомления о новых бронях ──────────────────────────────────────────────

# Telegram — самый быстрый канал: владелец узнаёт о брони за секунды.
# Если не заполнено, заявка всё равно сохраняется, а администратор видит её
# в /admin. Никаких «отправлено», которых не было, система не показывает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Универсальный вебхук: Slack, CRM, чат отдела — что угодно, что принимает POST.
# Заголовок подписи: X-Notify-Signature (HMAC-SHA256 от тела).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ── Расписание ──────────────────────────────────────────────────────────────

# Демонстрационный профиль занятости. Заполняет часть слотов «проданными»,
# чтобы календарь выглядел живым на показе.
#
# ВАЖНО: это неправда о реальной загрузке. Включать только на показе/стенде,
# никогда — на рабочем сайте. По умолчанию выключено.
# DEMO_AVAILABILITY=1

# Внешний календарь площадки (если заведение ведёт расписание не здесь).
# Если не задано или недоступно, система честно отвечает «расписание
# недоступно» и не показывает устаревшие данные как свежие.
AVAILABILITY_API_URL=
AVAILABILITY_API_TOKEN=

# ── Оплата ──────────────────────────────────────────────────────────────────

# По умолчанию предоплата проходит вручную: администратор присылает реквизиты
# в WhatsApp и подтверждает оплату в админке. Онлайн-эквайринг подключается
# переменными ниже — без них кнопка онлайн-оплаты не показывается.
PAYMENT_API_URL=
PAYMENT_API_KEY=
# Секрет для проверки подписи вебхука платёжной системы.
# Вебхук без корректной подписи отклоняется: редирект клиента доказательством
# оплаты не считается.
PAYMENT_WEBHOOK_SECRET=

# ── Внешняя система учёта (CRM) ─────────────────────────────────────────────

# Если заведение ведёт учёт в другой системе, брони выгружаются туда.
# Ошибка выгрузки не теряется: она записывается в бронь и видна администратору
# пометкой «CRM: не выгружено».
CRM_API_URL=
CRM_API_TOKEN=

# ── Аналитика (необязательно) ───────────────────────────────────────────────

# Куда отправлять события воронки (просмотр → выбор квеста → бронь).
# Персональные данные в события не попадают: ни имени, ни телефона.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# ── Только для автотестов ───────────────────────────────────────────────────

# Открывает служебный сброс счётчиков частоты (/api/dev/reset-limits),
# без которого smoke-тесты невоспроизводимы.
#
# В ПРОДАКШЕНЕ НЕ ЗАДАВАТЬ: иначе лимит частоты можно сбросить извне.
# ALLOW_TEST_ENDPOINTS=1
