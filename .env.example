# ─────────────────────────────────────────────────────────────────────────────
# Quest Horror Clinic — переменные окружения
#
# Скопируйте в `.env.local` для разработки. В продакшене задайте те же
# переменные в панели хостинга (Vercel → Settings → Environment Variables).
# Файл `.env.local` в репозиторий не попадает.
#
# Значения-заглушки («placeholder», «change-me») система распознаёт и считает
# ошибкой конфигурации: переменная формально задана, но не работает. Это самый
# коварный вид ошибки, поэтому он проверяется отдельно.
#
# Проверить своё окружение:  npm run verify:production
# Посмотреть состояние живой системы:  curl -s <сайт>/api/health
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED — без этого продакшен не работает
# ═════════════════════════════════════════════════════════════════════════════

# Публичный адрес сайта: canonical, og:url, og:image, robots.txt, sitemap.
# Именно СВОЙ домен, а не адрес деплоя: иначе поисковик получает канонической
# ссылкой временный адрес, а превью в мессенджерах приходит без картинки.
# Значение подставляется на этапе сборки, поэтому менять его нужно ДО деплоя.
# Продакшн-домен также задан константой в lib/seo.ts (PRODUCTION_SITE_URL):
# если переменная забыта или смотрит на preview-деплой, разметка соберётся
# с этим доменом, а не со случайным адресом ветки.
NEXT_PUBLIC_SITE_URL=https://quest-new-five.vercel.app

# Пароль администратора (/admin). Без него панель закрыта.
# Значение `horror-clinic` действует только при NODE_ENV=development.
ADMIN_PASSWORD=

# Секрет подписи cookie админ-сессии. Случайная строка 32+ символа:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Внешний «замок» на /admin поверх пароля самой страницы (HTTP Basic).
# Пока переменная пустая — слой выключен, вход работает как раньше.
# Задайте её в продакшене: без неё достаточно одного угаданного пароля,
# чтобы получить доступ к персональным данным клиентов.
ADMIN_BASIC_PASSWORD=

# База данных. Обязательна на serverless-хостинге (Vercel и подобные):
# там файловое хранилище не переживает перезапуск инстанса, и брони теряются.
# Без неё система честно отключает онлайн-бронирование, а не теряет заявки.
# Установка: npm i pg  →  npm run migrate
DATABASE_URL=

# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — расширяет возможности, при отсутствии честно отключается
# ═════════════════════════════════════════════════════════════════════════════

# Часовой пояс площадки. Влияет на расписание, брони, напоминания, файл .ics.
# Обязательно с префиксом NEXT_PUBLIC_: тот же пояс нужен календарю в браузере,
# иначе «сегодня» на клиенте и на сервере разойдутся.
# При неверном значении система сообщит в лог и возьмёт Asia/Almaty.
NEXT_PUBLIC_VENUE_TIMEZONE=Asia/Almaty

# ── Уведомления о новых заявках ──────────────────────────────────────────────
# Панели администратора у сайта НЕТ, поэтому это единственный способ узнать
# о заявке. Без этих переменных заявка сохранится, но вы о ней не узнаете —
# поэтому проверка конфигурации считает это блокером, а не предупреждением.

# Telegram — работает «из коробки», рекомендуется как основной канал.
# 1) создать бота у @BotFather и получить токен;
# 2) написать боту любое сообщение;
# 3) открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Универсальный вебхук (Slack, CRM, n8n, Make, чат отдела): POST с заголовком
# X-Notify-Secret (HMAC-подпись, если секрет задан).
# Тело — плоский JSON: { title, text, id, quest, date, time, players,
# name, phone, messenger }. Разобранные поля лежат рядом с текстом, чтобы
# автоматизация не разбирала свободный текст регулярками.
#
# ПРО WHATSAPP. Написать клиенту в WhatsApp с сервера можно только через
# Cloud API Meta, и Meta требует одобренный шаблон (WABA). Без одобрения
# сообщение не отправится. Поэтому WhatsApp подключается через автоматизацию:
# в n8n/Make разверните вебхук в WhatsApp-узел с вашим одобренным шаблоном,
# а NOTIFY_WEBHOOK_URL укажите на адрес этого сценария. Сам сайт при этом
# ничего не имитирует — он честно отправляет POST, а дальше решает Meta.
# Если одобренного шаблона пока нет, работает Telegram.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ── Планировщик ─────────────────────────────────────────────────────────────
# Секрет для вызова /api/cron/reminders. Без него эндпоинт доступен только
# администратору, поэтому напоминания не отправляются и брони не истекают.
# Вызов раз в 15–30 минут:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://example.kz/api/cron/reminders
CRON_SECRET=

# ── Онлайн-оплата ───────────────────────────────────────────────────────────
# По умолчанию (переменные пусты) работает ручная предоплата: администратор
# присылает реквизиты и подтверждает оплату в панели. Это рабочий режим,
# а не «заглушка». Онлайн-эквайринг подключается этими переменными.
#
# ВНИМАНИЕ: PAYMENT_API_URL без PAYMENT_WEBHOOK_SECRET — ошибка. Вебхук
# включится, а подпись проверять будет нечем, и платёжное уведомление нельзя
# будет принимать достоверно.
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Внешняя система учёта (CRM) ─────────────────────────────────────────────
# По умолчанию система учёта — собственная база. Ошибка выгрузки во внешнюю
# CRM не теряется: она видна администратору пометкой «CRM: не выгружено».
CRM_API_URL=
CRM_API_TOKEN=

# ── Внешнее расписание ──────────────────────────────────────────────────────
# Если заведение ведёт расписание не здесь. При недоступности система честно
# отвечает «расписание недоступно», а не показывает устаревшие данные.
AVAILABILITY_API_URL=
AVAILABILITY_API_TOKEN=

# ── Аналитика воронки ───────────────────────────────────────────────────────
# Куда отправлять события (просмотр → выбор квеста → бронь). Персональные
# данные в события не попадают: ни имени, ни телефона, ни номера брони.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# ═════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT ONLY — в продакшене НЕ задавать
# ═════════════════════════════════════════════════════════════════════════════

# Открывает служебный сброс лимита частоты (/api/dev/reset-limits), без
# которого smoke-тесты невоспроизводимы. В продакшене это дыра: лимит частоты
# можно будет сбросить извне.
# ALLOW_TEST_ENDPOINTS=1

# Демонстрационный профиль занятости: заполняет часть слотов «проданными»,
# чтобы календарь выглядел живым на показе. Это НЕПРАВДА о реальной загрузке.
# Включать только на показе владельцу, никогда — на рабочем сайте.
# DEMO_AVAILABILITY=1

# ═════════════════════════════════════════════════════════════════════════════
# PRODUCTION ONLY — задаёт платформа
# ═════════════════════════════════════════════════════════════════════════════

# NODE_ENV=production   — включает проверки окружения и строгий режим
# VERCEL_URL            — подставляется Vercel автоматически (нужен только как
#                         запасной адрес, если NEXT_PUBLIC_SITE_URL не задан)
