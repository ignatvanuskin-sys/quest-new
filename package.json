{
  "name": "quest-horror-clinic",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic horror-quest website with online booking — Quest Horror Clinic (Almaty)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "npm run typecheck && npm run lint",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "test:booking": "node scripts/test-booking.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "pg": "^8.13.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  }
}
